{
  "name": "nuvio-calendar-archives-usa-fr-coexist",
  "version": "1.4.0",
  "private": true,
  "description": "France + USA + Türkiye + Global Anime/VOD + TMDb genres, 2030→2015 periods, cinematic backgrounds.",
  "scripts": {
    "start": "node local-server.js",
    "test": "node scripts/test-all.js",
    "build:runtime": "node scripts/build-runtime.js",
    "build:oracle": "npm run build:runtime",
    "test:runtime": "node --test test/runtime.test.js",
    "test:series": "node --test regions/series/test/*.test.cjs",
    "sync:series": "node scripts/sync-series-world.cjs",
    "test:movies": "node --test regions/movies/test/*.test.cjs",
    "sync:movies": "node scripts/sync-movies-world.cjs",
    "verify:movies:covers": "node scripts/verify-movie-covers.mjs",
