    "test:oracle": "node scripts/test-oracle-runtime.mjs",
    "verify:oracle:production": "node scripts/verify-oracle-production.mjs",
    "generate:covers": "node scripts/generate-platform-covers.js",
    "audit:editorial-covers": "node scripts/audit-editorial-covers.mjs",
    "audit:editorial-backdrops": "node scripts/audit-editorial-backdrops.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "sharp": "^0.34.3",
    "opentype.js": "^1.3.4",
    "dejavu-fonts-ttf": "^2.37.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
