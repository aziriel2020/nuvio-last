__PUBLIC_HOST__ {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }

  # One upstream only. An active health-check failure previously marked the
  # sole backend unavailable until the next 30-second probe, creating 503s
  # even after Nuvio recovered. The deployment workflow already checks local
  # and public health, with rollback on failure. Proxy requests directly.
  reverse_proxy 127.0.0.1:3000

  log {
    output file /var/log/caddy/nuvio-access.log {
      roll_size 50mb
      roll_keep 5
      roll_keep_for 168h
    }
    format json
  }
}
