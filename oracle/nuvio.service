[Unit]
Description=Nuvio Oracle VM runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuvio
Group=nuvio
WorkingDirectory=/opt/nuvio/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=NUVIO_CACHE_DIR=/var/cache/nuvio
Environment=NUVIO_CACHE_MAX_ENTRIES=24576
# V4 Custom Posters consumes original TMDB artwork; disable legacy per-catalog
# JPEG/SVG conversions in the production France catalog feed.
Environment=CALENDAR_CARDS=false
# Preserve native TMDB/TVDB/TVmaze artwork URLs; never relay/re-encode them.
Environment=NUVIO_V4_NATIVE_ART=1
# The native Nuvio media hook cannot decorate collection-folder cards:
# choose equivalent SVG folder artwork rather than generated JPEG renditions.
Environment=NUVIO_V4_COLLECTIONS=1
EnvironmentFile=/etc/nuvio/nuvio.env
EnvironmentFile=-/etc/nuvio/release.env
ExecStart=/usr/bin/node /opt/nuvio/current/oracle/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65535
MemoryMax=9G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/cache/nuvio /var/lib/nuvio-series /var/lib/nuvio-movies /opt/nuvio

[Install]
WantedBy=multi-user.target
