[Unit]
Description=Nuvio Oracle VM runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuvio
Group=nuvio
WorkingDirectory=/opt/nuvio/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=NUVIO_CACHE_DIR=/var/cache/nuvio
Environment=NUVIO_CACHE_MAX_ENTRIES=2048
EnvironmentFile=/etc/nuvio/nuvio.env
EnvironmentFile=-/etc/nuvio/release.env
ExecStart=/usr/bin/node /opt/nuvio/current/oracle/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65535
MemoryMax=9G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/cache/nuvio /opt/nuvio

[Install]
WantedBy=multi-user.target
